{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:using_item",
    "on_false": { "type": "minecraft:model", "model": "basicrpgclasses:item/simple_shortbow" },
    "on_true": {
      "type": "minecraft:range_dispatch",
      "property": "minecraft:use_duration",
      "scale": 0.067,
      "fallback": { "type": "minecraft:model", "model": "basicrpgclasses:item/simple_shortbow_pulling_0" },
      "entries": [
        { "threshold": 0.65, "model": { "type": "minecraft:model", "model": "basicrpgclasses:item/simple_shortbow_pulling_1" } },
        { "threshold": 0.9, "model": { "type": "minecraft:model", "model": "basicrpgclasses:item/simple_shortbow_pulling_2" } }
      ]
    }
  }
}
